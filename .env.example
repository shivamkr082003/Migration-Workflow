# Copy to .env (git-ignored). Every value has a working default for local development.

# Postgres started by `docker compose up -d db`
DATABASE_URL=postgres://workbench:workbench@localhost:5433/workbench

# Optional. When set, the planning agent uses Claude; otherwise the deterministic offline planner is used.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_MAX_TURNS=20

PORT=4000
LOG_LEVEL=info

# Demo conveniences. Disable both in any shared deployment.
ALLOW_FAULT_INJECTION=true
ALLOW_RESET=true
